# ==============================================================================
# Setlore Environment Configuration
# ==============================================================================

# Django Security & Host Settings
DJANGO_SECRET_KEY=change_this_to_a_random_secure_secret_key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Storage & Database Persistence (Optional overrides)
# DATA_DIR=data
# DATABASE_PATH=data/db.sqlite3

# Initial Superuser Account (Created on seed_user_one / docker startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
SETLISTFM_USER=admin

# External APIs
SETLISTFM_KEY=your_setlistfm_api_key_here
CONTACT_EMAIL=admin@example.com
# APP_URL is used in MusicBrainz API User-Agent headers; falls back to CSRF_TRUSTED_ORIGINS if unset
APP_URL=https://your-app-domain.com
CARTO_API_KEY=your_carto_api_key_here

# Google OAuth 2.0 (Optional: enables 1-click Google Sign-In & account linking)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/accounts/google/callback/
